 fn parse_quantity(text: &str) -> Result<u64, ()> {
-    text.parse().map_err(|_| ())
+    match parse_digits(text)? {
+        quantity @ 1..=1_000_000 => Ok(quantity),
+        _ => Err(()),
+    }
 }
 
 fn parse_cost(text: &str) -> Result<u64, ()> {
-    text.trim_start_matches('@').parse().map_err(|_| ())
+    match parse_digits(text.strip_prefix('@').ok_or(())?)? {
+        cost @ 0..=1_000_000 => Ok(cost),
+        _ => Err(()),
+    }
+}
+
+fn parse_digits(text: &str) -> Result<u64, ()> {
+    if text.is_empty() || !text.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(());
+    }
+    text.parse().map_err(|_| ())
 }
