+#[test]
+fn checkpoints_are_independent_and_tail_can_repeat_checkpoint_receipts() {
+    let mut j = empty();
+    let first = tx(3, vec![check("x", None)], vec![put("x", "v1")]);
+    j.commit(first.clone()).unwrap();
+    let checkpoint = j.checkpoint();
+    j.commit(tx(4, vec![], vec![put("x", "v2")])).unwrap();
+    let fresh = Journal::open(Some(&checkpoint), &[]).unwrap();
+    assert_eq!(fresh.get("x"), Some("v1"));
+    assert_eq!(fresh.revision(), 1);
+    let later = tx(
+        5,
+        vec![check("x", Some(1))],
+        vec![delete("x"), put("y", "next")],
+    );
+    let mut tail = encode_transaction(&first);
+    tail.extend(encode_transaction(&later));
+    tail.extend(encode_transaction(&first));
+    let restored = Journal::open(Some(&checkpoint), &tail).unwrap();
+    assert_eq!(restored.get("x"), None);
+    assert_eq!(restored.version("x"), Some(2));
+    assert_eq!(restored.get("y"), Some("next"));
+    assert_eq!(restored.revision(), 2);
+    assert_eq!(restored.bytes(), tail);
+    let checkpoint2 = restored.checkpoint();
+    let mut third = Journal::open(Some(&checkpoint2), &[]).unwrap();
+    assert_eq!(third.commit(first).unwrap().revision, 1);
+    assert_eq!(third.commit(later).unwrap().revision, 2);
+    assert!(third.bytes().is_empty());
+}
