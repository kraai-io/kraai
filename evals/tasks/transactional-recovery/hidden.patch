+#[test]
+fn every_torn_transaction_is_discarded_as_a_whole_before_next_append() {
+    let first = tx(1, vec![], vec![put("seed", "one")]);
+    let second = tx(
+        2,
+        vec![check("seed", Some(1))],
+        vec![put("seed", "two"), put("é\0", "😀\\'\""), delete("missing")],
+    );
+    let mut seed = empty();
+    seed.commit(first.clone()).unwrap();
+    let checkpoint = seed.checkpoint();
+    let second_bytes = encode_transaction(&second);
+    for checkpointed in [false, true] {
+        let prefix = if checkpointed {
+            vec![]
+        } else {
+            encode_transaction(&first)
+        };
+        for cut in 0..second_bytes.len() {
+            let mut torn = prefix.clone();
+            torn.extend_from_slice(&second_bytes[..cut]);
+            let cp = checkpointed.then_some(&checkpoint);
+            let mut j = Journal::open(cp, &torn).unwrap();
+            assert_eq!(j.revision(), 1, "cut={cut}");
+            assert_eq!(j.bytes(), prefix);
+            assert_eq!(j.get("seed"), Some("one"));
+            assert_eq!(j.version("missing"), None);
+            j.commit(second.clone()).unwrap();
+            let again = Journal::open(cp, j.bytes()).unwrap();
+            assert_eq!(again.checkpoint(), j.checkpoint());
+            assert_eq!(again.get("é\0"), Some("😀\\'\""));
+        }
+    }
+}
