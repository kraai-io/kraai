+#[test]
+fn empty_commits_count_and_structural_equality_is_exact() {
+    let mut j = empty();
+    let a = tx(0, vec![], vec![]);
+    assert_eq!(j.commit(a.clone()).unwrap().revision, 1);
+    assert_eq!(
+        j.commit(a).unwrap(),
+        Commit {
+            revision: 1,
+            applied: false
+        }
+    );
+    let b = tx(1, vec![check("a", None), check("b", None)], vec![]);
+    j.commit(b.clone()).unwrap();
+    let mut reordered = b.clone();
+    reordered.checks.reverse();
+    assert_eq!(j.commit(reordered), Err(Error::IdConflict(1)));
+    let mut duplicated = b;
+    duplicated.checks.push(check("a", None));
+    assert_eq!(j.commit(duplicated), Err(Error::IdConflict(1)));
+    let c = tx(2, vec![], vec![put("a", "a"), put("b", "b")]);
+    j.commit(c.clone()).unwrap();
+    let mut reordered = c;
+    reordered.writes.reverse();
+    assert_eq!(j.commit(reordered), Err(Error::IdConflict(2)));
+    assert_eq!(j.revision(), 3);
+}
