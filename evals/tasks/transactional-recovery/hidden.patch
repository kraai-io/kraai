+#[test]
+fn encoding_is_byte_compatible() {
+    let transaction = tx(
+        0x0102,
+        vec![check("é", Some(7)), check("", None)],
+        vec![put("a", "\0"), delete("\\'")],
+    );
+    let mut payload = 0x0102u64.to_le_bytes().to_vec();
+    payload.extend(2u32.to_le_bytes());
+    payload.extend([2, 0, 0, 0, 0xc3, 0xa9, 1]);
+    payload.extend(7u64.to_le_bytes());
+    payload.extend([0, 0, 0, 0, 0]);
+    payload.extend(2u32.to_le_bytes());
+    payload.extend([1, 1, 0, 0, 0, b'a', 1, 0, 0, 0, 0]);
+    payload.extend([2, 2, 0, 0, 0, b'\\', b'\'']);
+    assert_eq!(encode_transaction(&transaction), frame(&payload));
+}
