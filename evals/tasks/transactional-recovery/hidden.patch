+#[test]
+fn strict_decoder_checks_complete_frames_and_reports_frame_start() {
+    let good = encode_transaction(&tx(1, vec![], vec![]));
+    let mut malformed = vec![vec![], vec![0; 7], vec![0; 15]];
+    let mut extra = good[4..].to_vec();
+    extra.push(0);
+    malformed.push(extra);
+    let mut counts = good[4..].to_vec();
+    counts[8..12].copy_from_slice(&u32::MAX.to_le_bytes());
+    malformed.push(counts);
+    let mut counts = good[4..].to_vec();
+    counts[12..16].copy_from_slice(&u32::MAX.to_le_bytes());
+    malformed.push(counts);
+    let checked = encode_transaction(&tx(2, vec![check("", None)], vec![]));
+    let mut bad = checked[4..].to_vec();
+    bad[16] = 2;
+    malformed.push(bad);
+    let mut bad = checked[4..].to_vec();
+    bad[16] = 1;
+    malformed.push(bad);
+    let deletion = encode_transaction(&tx(3, vec![], vec![delete("x")]));
+    let mut bad = deletion[4..].to_vec();
+    bad[16] = 9;
+    malformed.push(bad);
+    let mut bad = deletion[4..].to_vec();
+    bad[21] = 255;
+    malformed.push(bad);
+    let mut bad = deletion[4..].to_vec();
+    bad[17..21].copy_from_slice(&u32::MAX.to_le_bytes());
+    malformed.push(bad);
+    let insertion = encode_transaction(&tx(4, vec![], vec![put("x", "y")]));
+    let payload = &insertion[4..];
+    for cut in 0..payload.len() {
+        malformed.push(payload[..cut].to_vec());
+    }
+    for payload in malformed {
+        for prefix in [vec![], good.clone()] {
+            let offset = prefix.len();
+            let mut bytes = prefix;
+            bytes.extend(frame(&payload));
+            bytes.extend_from_slice(&[0, 0]);
+            assert!(
+                matches!(Journal::open(None, &bytes), Err(Error::InvalidRecord { offset: got }) if got == offset),
+                "payload={payload:?}"
+            );
+        }
+    }
+    let mut incomplete = good.clone();
+    incomplete.extend(u32::MAX.to_le_bytes());
+    incomplete.extend([255, 255]);
+    assert_eq!(Journal::open(None, &incomplete).unwrap().bytes(), good);
+}
