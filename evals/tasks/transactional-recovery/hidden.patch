+#[derive(Clone, Default)]
+struct Model {
+    revision: u64,
+    cells: BTreeMap<String, (Option<String>, u64)>,
+    receipts: Vec<(Transaction, u64)>,
+}
+impl Model {
+    fn apply(&mut self, t: &Transaction) -> Result<Commit, Error> {
+        if let Some((old, revision)) = self.receipts.iter().find(|(old, _)| old.id == t.id) {
+            return if old == t {
+                Ok(Commit {
+                    revision: *revision,
+                    applied: false,
+                })
+            } else {
+                Err(Error::IdConflict(t.id))
+            };
+        }
+        for c in &t.checks {
+            let actual = self.cells.get(&c.key).map(|c| c.1);
+            if actual != c.version {
+                return Err(Error::Stale {
+                    key: c.key.clone(),
+                    expected: c.version,
+                    actual,
+                });
+            }
+        }
+        self.revision += 1;
+        for w in &t.writes {
+            let (k, v) = match w {
+                Write::Put { key, value } => (key, Some(value.clone())),
+                Write::Delete { key } => (key, None),
+            };
+            self.cells.insert(k.clone(), (v, self.revision));
+        }
+        self.receipts.push((t.clone(), self.revision));
+        Ok(Commit {
+            revision: self.revision,
+            applied: true,
+        })
+    }
+}
+fn random(seed: &mut u64) -> u64 {
+    *seed = seed
+        .wrapping_mul(6364136223846793005)
+        .wrapping_add(1442695040888963407);
+    *seed >> 24
+}
+
+#[test]
+fn generated_histories_match_independent_model_through_restarts_and_checkpoints() {
+    let keys = ["", "a", "β", "\0", "quotes'\\"];
+    for initial_seed in 1..=12 {
+        let mut seed = initial_seed;
+        let mut model = Model::default();
+        let mut journal = empty();
+        let mut checkpoint = None;
+        let mut tail = Vec::new();
+        for step in 0..160 {
+            let key = keys[random(&mut seed) as usize % keys.len()];
+            let mut transaction = tx(random(&mut seed) % 50, vec![], vec![]);
+            if random(&mut seed) % 3 == 0 && !model.receipts.is_empty() {
+                transaction = model.receipts[random(&mut seed) as usize % model.receipts.len()]
+                    .0
+                    .clone();
+                if random(&mut seed) % 4 == 0 {
+                    transaction.writes.push(delete(key));
+                }
+            } else {
+                for _ in 0..random(&mut seed) % 3 {
+                    let k = keys[random(&mut seed) as usize % keys.len()];
+                    let version = if random(&mut seed) % 3 == 0 {
+                        Some(random(&mut seed) % 20)
+                    } else {
+                        model.cells.get(k).map(|c| c.1)
+                    };
+                    transaction.checks.push(check(k, version));
+                }
+                for _ in 0..random(&mut seed) % 4 {
+                    let k = keys[random(&mut seed) as usize % keys.len()];
+                    transaction.writes.push(if random(&mut seed) % 3 == 0 {
+                        delete(k)
+                    } else {
+                        put(k, &format!("{step}:é\0'\\"))
+                    });
+                }
+            }
+            let expected = model.apply(&transaction);
+            assert_eq!(
+                journal.commit(transaction.clone()),
+                expected,
+                "seed={initial_seed} step={step}"
+            );
+            if matches!(expected, Ok(Commit { applied: true, .. })) {
+                tail.extend(encode_transaction(&transaction));
+            }
+            assert_eq!(journal.bytes(), tail);
+            assert_eq!(journal.revision(), model.revision);
+            let values: BTreeMap<_, _> = model
+                .cells
+                .iter()
+                .filter_map(|(k, (v, _))| v.as_ref().map(|v| (k.clone(), v.clone())))
+                .collect();
+            assert_eq!(journal.snapshot(), values);
+            for key in keys {
+                assert_eq!(journal.version(key), model.cells.get(key).map(|c| c.1));
+                assert_eq!(journal.get(key), values.get(key).map(String::as_str));
+            }
+            if step % 11 == 0 {
+                let mut torn = tail.clone();
+                torn.extend_from_slice(&[255, 255, 255]);
+                journal = Journal::open(checkpoint.as_ref(), &torn).unwrap();
+                assert_eq!(journal.bytes(), tail);
+            }
+            if step % 23 == 0 {
+                checkpoint = Some(journal.checkpoint());
+                journal = Journal::open(checkpoint.as_ref(), &[]).unwrap();
+                tail.clear();
+            }
+        }
+        assert_eq!(
+            Journal::open(checkpoint.as_ref(), &tail)
+                .unwrap()
+                .checkpoint(),
+            journal.checkpoint()
+        );
+    }
+}
