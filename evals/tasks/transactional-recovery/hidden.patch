+#[test]
+fn deletion_has_a_version_even_for_never_present_keys() {
+    let mut j = empty();
+    j.commit(tx(10, vec![], vec![delete("absent")])).unwrap();
+    assert_eq!(j.get("absent"), None);
+    assert_eq!(j.version("absent"), Some(1));
+    assert_eq!(j.version("never"), None);
+    let stale = tx(11, vec![check("absent", None)], vec![put("absent", "bad")]);
+    assert!(matches!(
+        j.commit(stale),
+        Err(Error::Stale {
+            actual: Some(1),
+            ..
+        })
+    ));
+    let checkpoint = j.checkpoint();
+    let mut restored = Journal::open(Some(&checkpoint), &[]).unwrap();
+    assert_eq!(restored.version("absent"), Some(1));
+    restored
+        .commit(tx(
+            11,
+            vec![check("absent", Some(1))],
+            vec![put("absent", "reborn")],
+        ))
+        .unwrap();
+    assert_eq!(restored.version("absent"), Some(2));
+    let restarted = Journal::open(Some(&checkpoint), restored.bytes()).unwrap();
+    assert_eq!(restarted.checkpoint(), restored.checkpoint());
+}
