+#[test]
+fn replay_conflicts_and_stale_checks_are_not_ignored() {
+    let first = tx(9, vec![], vec![put("x", "one")]);
+    let mut log = encode_transaction(&first);
+    log.extend(encode_transaction(&tx(9, vec![check("x", None)], vec![])));
+    assert!(matches!(
+        Journal::open(None, &log),
+        Err(Error::IdConflict(9))
+    ));
+    let mut log = encode_transaction(&first);
+    log.extend(encode_transaction(&tx(
+        10,
+        vec![check("x", None)],
+        vec![put("x", "wrong")],
+    )));
+    assert!(
+        matches!(Journal::open(None, &log), Err(Error::Stale { key, expected: None, actual: Some(1) }) if key == "x")
+    );
+}
