+use std::collections::BTreeMap;
+use transactional_recovery::{
+    Check, Commit, Error, Journal, Transaction, Write, encode_transaction,
+};
+
+fn put(key: &str, value: &str) -> Write {
+    Write::Put {
+        key: key.into(),
+        value: value.into(),
+    }
+}
+fn delete(key: &str) -> Write {
+    Write::Delete { key: key.into() }
+}
+fn check(key: &str, version: Option<u64>) -> Check {
+    Check {
+        key: key.into(),
+        version,
+    }
+}
+fn tx(id: u64, checks: Vec<Check>, writes: Vec<Write>) -> Transaction {
+    Transaction { id, checks, writes }
+}
+fn empty() -> Journal {
+    Journal::open(None, &[]).unwrap()
+}
+fn frame(payload: &[u8]) -> Vec<u8> {
+    let mut bytes = (payload.len() as u32).to_le_bytes().to_vec();
+    bytes.extend_from_slice(payload);
+    bytes
+}
+
+#[test]
+fn checks_see_one_pretransaction_snapshot_and_errors_are_atomic() {
+    let mut j = empty();
+    j.commit(tx(1, vec![], vec![put("x", "old"), put("y", "old")]))
+        .unwrap();
+    let before = j.checkpoint();
+    let bytes = j.bytes().to_vec();
+    let bad = tx(
+        2,
+        vec![check("x", Some(1)), check("y", None), check("z", Some(9))],
+        vec![put("x", "wrong"), delete("y")],
+    );
+    assert_eq!(
+        j.commit(bad),
+        Err(Error::Stale {
+            key: "y".into(),
+            expected: None,
+            actual: Some(1)
+        })
+    );
+    assert_eq!(j.checkpoint(), before);
+    assert_eq!(j.bytes(), bytes);
+    let good = tx(
+        2,
+        vec![check("x", Some(1)), check("x", Some(1))],
+        vec![delete("x"), put("x", "new"), delete("y"), put("z", "last")],
+    );
+    assert_eq!(
+        j.commit(good).unwrap(),
+        Commit {
+            revision: 2,
+            applied: true
+        }
+    );
+    assert_eq!(j.get("x"), Some("new"));
+    assert_eq!(j.get("y"), None);
+    assert_eq!(j.version("y"), Some(2));
+    assert_eq!(j.version("z"), Some(2));
+    assert_eq!(j.revision(), 2);
+}
+
+#[test]
+fn duplicate_receipts_precede_checks_and_preserve_original_revision() {
+    let mut j = empty();
+    let first = tx(u64::MAX, vec![check("x", None)], vec![put("x", "first")]);
+    j.commit(first.clone()).unwrap();
+    j.commit(tx(0, vec![], vec![put("x", "newer")])).unwrap();
+    let bytes = j.bytes().to_vec();
+    assert_eq!(
+        j.commit(first.clone()).unwrap(),
+        Commit {
+            revision: 1,
+            applied: false
+        }
+    );
+    assert_eq!(j.get("x"), Some("newer"));
+    assert_eq!(j.bytes(), bytes);
+    let mut conflicting = first.clone();
+    conflicting.checks.push(check("missing", Some(7)));
+    assert_eq!(j.commit(conflicting), Err(Error::IdConflict(u64::MAX)));
+    assert_eq!(j.revision(), 2);
+    let checkpoint = j.checkpoint();
+    let mut restored = Journal::open(Some(&checkpoint), &[]).unwrap();
+    assert_eq!(
+        restored.commit(first).unwrap(),
+        Commit {
+            revision: 1,
+            applied: false
+        }
+    );
+    assert!(restored.bytes().is_empty());
+    assert_eq!(restored.snapshot(), j.snapshot());
+}
