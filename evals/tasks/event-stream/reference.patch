+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Event {
+    pub event: String,
+    pub id: Option<String>,
+    pub data: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DecodeError {
+    InvalidUtf8,
+    Finished,
+}
+
+#[derive(Default)]
+pub struct Decoder {
+    line: Vec<u8>,
+    started: bool,
+    swallow_lf: bool,
+    data: Vec<String>,
+    event: String,
+    id: Option<String>,
+    closed: bool,
+    invalid: bool,
+}
+
+impl Decoder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn feed(&mut self, bytes: &[u8]) -> Result<Vec<Event>, DecodeError> {
+        self.check_state()?;
+        let mut events = Vec::new();
+        for &byte in bytes {
+            if self.swallow_lf {
+                self.swallow_lf = false;
+                if byte == b'\n' {
+                    continue;
+                }
+            }
+            if byte == b'\r' || byte == b'\n' {
+                if self.complete_line(&mut events).is_err() {
+                    self.invalid = true;
+                    return Err(DecodeError::InvalidUtf8);
+                }
+                self.swallow_lf = byte == b'\r';
+            } else {
+                self.line.push(byte);
+            }
+        }
+        Ok(events)
+    }
+
+    pub fn finish(&mut self) -> Result<Vec<Event>, DecodeError> {
+        self.check_state()?;
+        if std::str::from_utf8(&self.line).is_err() {
+            self.invalid = true;
+            return Err(DecodeError::InvalidUtf8);
+        }
+        self.line.clear();
+        self.data.clear();
+        self.closed = true;
+        Ok(Vec::new())
+    }
+
+    pub fn last_event_id(&self) -> Option<&str> {
+        self.id.as_deref()
+    }
+
+    fn check_state(&self) -> Result<(), DecodeError> {
+        if self.invalid {
+            Err(DecodeError::InvalidUtf8)
+        } else if self.closed {
+            Err(DecodeError::Finished)
+        } else {
+            Ok(())
+        }
+    }
+
+    fn complete_line(&mut self, events: &mut Vec<Event>) -> Result<(), DecodeError> {
+        let bytes = std::mem::take(&mut self.line);
+        let mut line = std::str::from_utf8(&bytes).map_err(|_| DecodeError::InvalidUtf8)?;
+        if !self.started {
+            line = line.strip_prefix('\u{feff}').unwrap_or(line);
+            self.started = true;
+        }
+        if line.is_empty() {
+            if !self.data.is_empty() {
+                events.push(Event {
+                    event: if self.event.is_empty() { "message".into() } else { self.event.clone() },
+                    id: self.id.clone(),
+                    data: self.data.join("\n"),
+                });
+            }
+            self.data.clear();
+            self.event.clear();
+            return Ok(());
+        }
+        if line.starts_with(':') {
+            return Ok(());
+        }
+        let (field, value) = line.split_once(':').unwrap_or((line, ""));
+        let value = value.strip_prefix(' ').unwrap_or(value);
+        match field {
+            "data" => self.data.push(value.into()),
+            "event" => self.event = value.into(),
+            "id" if !value.contains('\0') => self.id = Some(value.into()),
+            _ => {}
+        }
+        Ok(())
+    }
+}
